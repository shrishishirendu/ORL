APP_ENV=development
DATABASE_URL=postgresql+asyncpg://orl:orl@localhost:5432/orl
REDIS_URL=redis://localhost:6379/0
# Flat hourly rate used to compute pay_cost on auto-generated placeholder
# AwardCostMatrix rows (see app/services/admin_data/eligibility.py).
PLACEHOLDER_HOURLY_RATE=40.0
# Award Engine service (docs/AWARD_ENGINE_CONTRACT.md). Leave AWARD_ENGINE_URL
# unset to run without the engine (placeholder costs, flagged as such).
# AWARD_ENGINE_URL=http://localhost:8790
AWARD_ENGINE_TIMEOUT_S=30
AWARD_JURISDICTION=NSW
# AWARD_LEGAL_EMPLOYER=
# AWARD_WORK_TYPE=
